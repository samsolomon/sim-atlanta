{
  "name": "train-map",
  "private": true,
  "scripts": {
    "data": "cargo run --release --manifest-path pipeline/Cargo.toml -- all",
    "dev": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "secrets:local": "umask 077 && printf 'MARTA_API_KEY=%s\\n' \"$(op read 'op://Personal/trains-marta-api/credential')\" > worker/.dev.vars",
    "build": "pnpm --filter web build",
    "deploy": "pnpm --filter worker deploy",
    "test": "cargo test --manifest-path pipeline/Cargo.toml && pnpm --filter web test && pnpm --filter worker test"
  }
}
